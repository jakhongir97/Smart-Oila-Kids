	<!--
	  Probe schemes for the installed-app catalogue (AppCatalogue.swift).
	  canOpenURL returns false for ANY scheme that is not declared here, even when the app IS
	  installed, so this array and AppCatalogue.probeSchemes must stay identical — pinned by
	  AppCatalogueTests.testEveryProbeSchemeIsDeclaredInTheInfoPlist.
	  Apple caps this key at 50 entries for apps linked with the iOS 15+ SDK and at 25 for apps
	  linked with the iOS 27 SDK, and does not document which entries survive an overflow. We
	  ship 25 so the list never has to be cut when the toolchain moves.
	-->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>tg</string>
		<string>snssdk1233</string>
		<string>instagram</string>
		<string>youtube</string>
		<string>whatsapp</string>
		<string>roblox</string>
		<string>fb1036341366506456</string>
		<string>fb752573801798020</string>
		<string>brawlstars</string>
		<string>fb2036793259884297</string>
		<string>minecraft</string>
		<string>snapchat</string>
		<string>discord</string>
		<string>fb</string>
		<string>fb-messenger</string>
		<string>clashroyale</string>
		<string>clashofclans</string>
		<string>mobilelegends</string>
		<string>googlechrome</string>
		<string>yandexbrowser-open-url</string>
		<string>chatgpt</string>
		<string>spotify</string>
		<string>twitter</string>
		<string>reddit</string>
		<string>com.epicgames.fortnite</string>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSCameraUsageDescription</key>
	<string>A parent can start a live video check to see your child's surroundings. Your child is asked to allow it, and an on-screen indicator appears while the camera is on. The app never records or saves video.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Location is used so the parent can see the child device location, including while the app is in the background.</string>
	<key>NSLocationAlwaysUsageDescription</key>
	<string>Location is used so the parent can see the child device location, including while the app is in the background.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Location is used so the parent can see the child device location while the app is open.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>A parent can start a live audio check, or a live video check that also carries sound. Your child is asked to allow it, and an on-screen indicator appears while the microphone is on. The app never records or saves audio.</string>
